{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vox",
  "version": "0.8.7",
  "identifier": "com.addy.Vox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vox",
        "maximized": true,
        "visible": true,
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#050505",
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["test-clips/*", "resources/setup_server.sh"]
  },
  "plugins": {}
}
